{
  "name": "dsh-multiple-connect",
  "version": "0.2.6",
  "icon": "./assets/logo-plugin-message-link-gradient.webp",
  "description": "Connect messaging platforms to a shared DeepSeek Harness conversation and a persistent external inbox.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "im",
    "instant-messaging",
    "chatbot",
    "feishu",
    "lark",
    "wechat",
    "wecom",
    "dingtalk",
    "qq",
    "slack",
    "telegram",
    "discord",
    "whatsapp",
    "imessage",
    "matrix",
    "ai-office"
  ],
  "author": "DSH-MultipleConnect contributors (upstream xmanrui, johnnren and contributors)",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "plugin-src",
    "scripts/verify-interface-language.mjs",
    "scripts/verify-injected-context.mjs",
    "scripts/verify-lan-management.mjs",
    "scripts/verify-model-setting.mjs",
    "scripts/verify-package.mjs",
    "scripts/verify-session-channel-logos.mjs",
    "scripts/verify-session-title-prefix.mjs",
    "src",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "vendor/proactive/LICENSE",
    "vendor/proactive/src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/*/*.test.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@matrix-org/olm": "3.2.15",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.4",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "qrcode": "1.5.4",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "esbuild": "0.25.9",
    "https-proxy-agent": "5.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "optionalDependencies": {
    "@tencent-qqmail/agently-cli": "^1.0.18",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.2-rc.1 - 0.2.2-rc.5"
  }
}
